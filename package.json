{
  "name": "tech-primer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:mindmaps && node scripts/build-pwa.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "kv:create": "wrangler kv namespace create USER_STORE",
    "kv:create:preview": "wrangler kv namespace create USER_STORE --preview",
    "tail": "wrangler tail",
    "build:mindmaps": "node scripts/build-mindmaps.mjs",
    "test": "node tests/build/build-pwa.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "wrangler": "^4.87.0"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "dompurify": "3.4.13",
    "fuse.js": "7.5.0",
    "marked": "18.0.9",
    "mermaid": "11.16.1",
    "pako": "3.0.1"
  }
}
